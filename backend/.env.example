DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/binance_app

# En az 32 karakterlik rastgele bir değer kullanın: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-.env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Binance API secret'larını DB'de şifrelemek için Fernet key üretin:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=change-me-generate-a-fernet-key

CORS_ORIGINS=["http://localhost:5173"]

BINANCE_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
